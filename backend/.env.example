LIGHTMAP_DEBUG=false
# Comma-separated list of allowed frontends. For Render, set this to the deployed frontend origin.
LIGHTMAP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LIGHTMAP_FRONTEND_ORIGIN=http://localhost:5173
LIGHTMAP_MAX_UPLOAD_SIZE_MB=10
LIGHTMAP_MAX_IMAGE_WIDTH=4096
LIGHTMAP_MAX_IMAGE_HEIGHT=4096
# Optional deep model checkpoint path; leave empty if the checkpoint is not available.
LIGHTMAP_DEEP_CHECKPOINT_PATH=
LIGHTMAP_RETINEXFORMER_REPO_PATH=
